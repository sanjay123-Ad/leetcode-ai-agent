# Copy to .env.local and fill in. Never commit .env.local.

# ---- Required ----------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Optional ----------------------------------------------------------------
# Generation model. Defaults to gemini-3.5-flash-lite (cheap, and what the
# benchmark in UPGRADE_REPORT.md was measured with).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Judge0 on RapidAPI: https://rapidapi.com/judge0-official/api/judge0-ce
# Only needed when no JDK is on PATH. With a local JDK the agent compiles and
# runs solutions itself, which is free and faster.
JUDGE0_API_KEY=
# JUDGE0_HOST=judge0-ce.p.rapidapi.com

# Run history. Entirely optional: without it the agent appends to history.json
# in the project directory (skipped on serverless hosts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred for server-side writes, so the public anon key does not need
# INSERT permission on the problem_history table:
# SUPABASE_SERVICE_ROLE_KEY=

# Where the local history file goes (defaults to ./history.json).
# AGENT_HISTORY_FILE=

# Shared secret for GET /api/cron. Send it as `Authorization: Bearer <secret>`
# or `x-cron-secret: <secret>`; the ?secret= query parameter still works but is
# deprecated because query strings end up in logs.
CRON_SECRET=

# Absolute base URL, used only for building links in server-side contexts.
NEXTAUTH_URL=http://localhost:3000
