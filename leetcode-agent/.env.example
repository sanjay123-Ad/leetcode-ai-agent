# Copy to .env.local and fill in. Never commit .env.local.

# ---- Required ----------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Optional ----------------------------------------------------------------
# Generation model. Defaults to gemini-3.5-flash-lite (cheap, and what the
# benchmark in UPGRADE_REPORT.md was measured with).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Judge0 on RapidAPI: https://rapidapi.com/judge0-official/api/judge0-ce
# Only needed when no JDK is on PATH. With a local JDK the agent compiles and
# runs solutions itself, which is free and faster.
JUDGE0_API_KEY=
# JUDGE0_HOST=judge0-ce.p.rapidapi.com

# ---- Run history (Supabase) --------------------------------------------------
# Optional. Without it a run still completes and still emails; the record is
# parked in ./pending-persist/ and the failure is reported, never hidden.
SUPABASE_URL=

# Server-side key. REQUIRED to write agent_runs: that table has RLS enabled with
# no policies, so the publishable/anon key is denied by design. Never put this in
# client code or NEXT_PUBLIC_*.
#   1st choice (current convention):
SUPABASE_SECRET_KEY=
#   fallback (legacy service-role JWT):
# SUPABASE_SERVICE_ROLE_KEY=

# Publishable key. Only used to read the legacy problem_history table.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where failed saves are parked for replay (defaults to ./pending-persist).
# AGENT_PENDING_DIR=

# ---- History endpoint --------------------------------------------------------
# GET /api/history is deny-by-default: with this unset it serves nobody. Set it to
# any long random string and send `Authorization: Bearer <token>`. The dashboard
# does not use it - its panel is server-rendered - so the token never reaches the
# browser.
HISTORY_API_TOKEN=

# Shortens HTTP retry backoff. For tests and dry runs only; leave unset in production.
# HTTP_RETRY_BASE_MS=

# Shared secret for GET /api/cron. Send it as `Authorization: Bearer <secret>`
# or `x-cron-secret: <secret>`; the ?secret= query parameter still works but is
# deprecated because query strings end up in logs.
CRON_SECRET=

# Absolute base URL, used only for building links in server-side contexts.
NEXTAUTH_URL=http://localhost:3000
